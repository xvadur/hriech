{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hriech.xvadur.com/contracts/media/v1/editorial-organization-map.schema.json",
  "title": "Editorial Organization Map v1",
  "description": "Public Hriech newsroom map built only from public professional and institutional records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "visibility",
    "generatedAt",
    "observedAt",
    "scope",
    "sourcePolicy",
    "privacy",
    "outlets",
    "sources"
  ],
  "properties": {
    "schemaVersion": { "const": "hriech.editorial-organization-map.v1" },
    "visibility": { "const": "public" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "observedAt": { "type": "string", "format": "date-time" },
    "scope": { "type": "string", "minLength": 1, "maxLength": 500 },
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden", "secondarySourcesAreLeadsOnly"],
      "properties": {
        "allowed": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 180 } },
        "forbidden": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 180 } },
        "secondarySourcesAreLeadsOnly": { "const": true }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicProfessionalDataOnly",
        "privateAddressesIncluded",
        "birthDataIncluded",
        "familyDataIncluded",
        "privateContactsIncluded",
        "personalPropertySearchIncluded"
      ],
      "properties": {
        "publicProfessionalDataOnly": { "const": true },
        "privateAddressesIncluded": { "const": false },
        "birthDataIncluded": { "const": false },
        "familyDataIncluded": { "const": false },
        "privateContactsIncluded": { "const": false },
        "personalPropertySearchIncluded": { "const": false }
      }
    },
    "outlets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/outlet" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 180
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "evidenceState": {
      "enum": ["current_verified", "documented_historical", "inference", "unknown"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "publisher", "url", "sourceKind", "capturedAt", "authority", "publicSafe"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 180 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sourceKind": { "enum": ["official_roster", "official_outlet", "official_registry", "financial_filing", "public_contract", "court_decision", "professional_profile"] },
        "publishedAt": { "type": "string", "format": "date-time" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "authority": { "enum": ["primary", "secondary_lead"] },
        "publicSafe": { "const": true },
        "note": { "type": "string", "maxLength": 500 }
      }
    },
    "outlet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "legalEntity",
        "website",
        "mappingState",
        "coverage",
        "products",
        "units",
        "people",
        "relationships",
        "financialFacts",
        "openQuestions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "legalEntity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "registrationId", "legalForm", "registeredOffice", "sourceRefIds"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 180 },
            "registrationId": { "type": "string", "pattern": "^[0-9]{8}$" },
            "legalForm": { "type": "string", "minLength": 1, "maxLength": 100 },
            "registeredOffice": { "type": "string", "minLength": 1, "maxLength": 240 },
            "sourceRefIds": { "$ref": "#/$defs/sourceIds" }
          }
        },
        "website": { "type": "string", "format": "uri", "pattern": "^https://" },
        "mappingState": { "enum": ["seed", "partial", "public_roster_mapped", "reviewed"] },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "knownGaps", "rosterObservedAt"],
          "properties": {
            "summary": { "type": "string", "minLength": 1, "maxLength": 700 },
            "knownGaps": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
            "rosterObservedAt": { "type": "string", "format": "date-time" }
          }
        },
        "products": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "kind", "relationship", "evidenceState", "sourceRefIds"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "type": "string", "minLength": 1, "maxLength": 180 },
              "kind": { "enum": ["publication", "news_service", "desk", "newsletter", "podcast", "print", "magazine", "books", "events", "education", "software", "investment", "acquisition"] },
              "relationship": { "type": "string", "minLength": 1, "maxLength": 300 },
              "url": { "type": "string", "format": "uri", "pattern": "^https://" },
              "evidenceState": { "$ref": "#/$defs/evidenceState" },
              "sourceRefIds": { "$ref": "#/$defs/sourceIds" }
            }
          }
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "maxItems": 300,
          "items": { "$ref": "#/$defs/unit" }
        },
        "people": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3000,
          "items": { "$ref": "#/$defs/person" }
        },
        "relationships": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/relationship" }
        },
        "financialFacts": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/financialFact" }
        },
        "openQuestions": {
          "type": "array",
          "maxItems": 300,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "evidenceState", "sourceRefIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "kind": { "enum": ["publisher", "newsroom", "leadership", "governance", "ownership", "editorial", "desk", "production", "design", "proofreading", "books", "commercial", "support", "technology", "data"] },
        "parentId": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "maxLength": 500 },
        "evidenceState": { "$ref": "#/$defs/evidenceState" },
        "sourceRefIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "roles", "observedAt", "sourceRefIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "profileUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "roles": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/role" } },
        "professionalNote": { "type": "string", "maxLength": 700 },
        "observedAt": { "type": "string", "format": "date-time" },
        "sourceRefIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "unitId", "roleLevel", "rosterStatus", "evidenceState", "sourceRefIds"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "unitId": { "$ref": "#/$defs/id" },
        "roleLevel": { "enum": ["editorial_leadership", "unit_lead", "editorial_staff", "production_staff", "support_staff", "publisher_leadership", "governance", "owner", "commercial_staff", "technology_staff", "external_contributor", "unknown"] },
        "rosterStatus": { "enum": ["listed_current", "external_listed", "historical", "unknown"] },
        "evidenceState": { "$ref": "#/$defs/evidenceState" },
        "sourceRefIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subjectType", "subjectId", "predicate", "objectType", "objectLabel", "evidenceState", "observedAt", "sourceRefIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subjectType": { "enum": ["person", "outlet", "legal_entity", "unit"] },
        "subjectId": { "$ref": "#/$defs/id" },
        "predicate": { "enum": ["leads", "member_of", "works_for", "executive_of", "chair_of_board", "board_member_of", "supervisory_board_member_of", "editorial_council_member_of", "beneficial_owner_of", "shareholder_of", "owns", "owns_share_in", "minority_owner_of", "co_owner_of", "owns_via_subsidiary", "partner_public_sector", "cooperates_with", "received_public_funds_from", "contracted_with", "publishes", "operates"] },
        "objectType": { "enum": ["person", "outlet", "legal_entity", "unit", "public_body", "product"] },
        "objectId": { "$ref": "#/$defs/id" },
        "objectLabel": { "type": "string", "minLength": 1, "maxLength": 240 },
        "note": { "type": "string", "maxLength": 700 },
        "evidenceState": { "$ref": "#/$defs/evidenceState" },
        "observedAt": { "type": "string", "format": "date-time" },
        "sourceRefIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "financialFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "period", "metric", "value", "unit", "evidenceState", "sourceRefIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "period": { "type": "string", "minLength": 4, "maxLength": 40 },
        "metric": { "type": "string", "minLength": 1, "maxLength": 240 },
        "value": { "type": ["number", "string"] },
        "unit": { "type": "string", "minLength": 1, "maxLength": 80 },
        "note": { "type": "string", "maxLength": 700 },
        "evidenceState": { "$ref": "#/$defs/evidenceState" },
        "sourceRefIds": { "$ref": "#/$defs/sourceIds" }
      }
    }
  }
}
