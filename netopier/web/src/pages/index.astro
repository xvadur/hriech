---
import '../styles/global.css';
import { vydanie, type Udalost } from '../lib/netopier';

const v = vydanie();
const TZ = 'Europe/Bratislava';
const hodMin = new Intl.DateTimeFormat('sk-SK', { hour: '2-digit', minute: '2-digit', timeZone: TZ });
const denDatum = new Intl.DateTimeFormat('sk-SK', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: TZ });
const denKratko = new Intl.DateTimeFormat('sk-SK', { weekday: 'short', timeZone: TZ });
const cislo = new Intl.NumberFormat('sk-SK');
const dnes = new Intl.DateTimeFormat('sk-SK', { day: 'numeric', month: 'numeric', timeZone: TZ });
const cas = (s: string) => {
  const d = new Date(s);
  return dnes.format(d) === dnes.format(new Date()) ? hodMin.format(d) : `${denKratko.format(d)} ${hodMin.format(d)}`;
};
const predMin = v.prijem ? Math.max(0, Math.round((Date.now() - Date.parse(v.prijem.koniec)) / 60_000)) : null;
const [hlavna, druha, ...dalsie] = v.udalosti as [Udalost, Udalost, ...Udalost[]];
const kickerFarba: Record<string, string> = {
  svet: 'bg-[var(--fg)] text-[var(--bg)]',
  europa: 'bg-[var(--color-pink)] text-[var(--color-ink)]',
  slovensko: 'bg-[var(--card)] text-[var(--fg)]',
};
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Netopier · Vydanie č. {v.cislo}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23f18fa0'/><circle cx='16' cy='16' r='6' fill='%23181616'/></svg>" />
  </head>
  <body class="min-h-screen">
    <header class="border-b-[3px] border-[var(--border)]">
      <div class="mx-auto flex max-w-[1320px] flex-wrap items-end justify-between gap-x-6 gap-y-2 px-4 pb-3 pt-5 sm:px-6">
        <div>
          <a href="/" class="font-display text-4xl font-extrabold tracking-tight sm:text-5xl">NETOPIER</a>
          <p class="mt-1 font-semibold text-[var(--fg-muted)]">
            Vydanie č. {v.cislo} · {denDatum.format(new Date(v.uzavierka))} · uzávierka {hodMin.format(new Date(v.uzavierka))}
          </p>
        </div>
        <nav class="flex items-center gap-2 text-sm font-bold">
          <a href="/" class="bk-chip bg-[var(--fg)] px-3 py-1 text-[var(--bg)]" aria-current="page">Vydanie</a>
          <a href="/prijem" class="bk-chip bg-[var(--card)] px-3 py-1">Príjem naživo</a>
        </nav>
      </div>
      <div class="border-t-2 border-[var(--color-line)] dark:border-[#3a3234]">
        <p class="mx-auto flex max-w-[1320px] items-center gap-2 px-4 py-1.5 text-sm text-[var(--fg-muted)] sm:px-6">
          <span class="live-bodka inline-block size-2 rounded-full bg-[var(--color-alarm)]"></span>
          {
            v.prijem
              ? `Netopier číta ${v.prijem.kanalov} kanálov, posledný príjem pred ${predMin} min. Počty pri udalostiach sú živé.`
              : 'Príjem zatiaľ nehlási stav.'
          }
        </p>
      </div>
    </header>

    <main class="mx-auto grid max-w-[1320px] gap-8 px-4 py-6 sm:px-6 lg:grid-cols-12">
      <div class="min-w-0 space-y-8 lg:col-span-8">
        {
          [hlavna, druha].map((u, i) => (
            <article class="bk-card min-w-0 break-words p-5 sm:p-7" id={u.id}>
              <span class:list={['inline-block rounded-full border-2 border-[var(--border)] px-2.5 py-0.5 text-xs font-bold uppercase tracking-wide', kickerFarba[u.oblast]]}>
                {u.kicker}
              </span>
              <h2
                class:list={[
                  'mt-3 font-display font-extrabold leading-[1.08] tracking-[-0.03em]',
                  i === 0 ? 'text-[clamp(2rem,4.4vw,3.4rem)]' : 'text-[clamp(1.7rem,3.2vw,2.5rem)]',
                ]}
              >
                {u.titulok}
              </h2>
              <p class="mt-4 text-[20px] leading-[1.6]">{u.perex}</p>
              <p class="mt-4 text-sm font-semibold text-[var(--fg-muted)]">
                Píše o tom {cislo.format(u.zivo.zdrojov)} redakcií · {cislo.format(u.zivo.sprav)} správ za 48 h
                {u.zivo.zaHodinu > 0 && ` · ${u.zivo.zaHodinu} za poslednú hodinu`}
              </p>
              <div class="mt-5 grid gap-5 md:grid-cols-5">
                <section class="md:col-span-3">
                  <h3 class="font-display text-lg font-extrabold">Čo vieme</h3>
                  <ul class="mt-2 space-y-3">
                    {u.vieme.map((t) => (
                      <li class="border-l-[3px] border-[var(--color-pink)] pl-3 text-[17px] leading-snug">
                        {t.text} <span class="text-sm font-semibold text-[var(--fg-muted)]">({t.zdroj})</span>
                      </li>
                    ))}
                  </ul>
                </section>
                <div class="space-y-5 md:col-span-2">
                  {u.nevieme.length > 0 && (
                    <section class="rounded-[8px] border-2 border-[var(--border)] bg-[var(--bg)] p-3">
                      <h3 class="font-display text-lg font-extrabold">Čo nevieme</h3>
                      <ul class="mt-2 list-disc space-y-2 pl-5 text-[16px] leading-snug">
                        {u.nevieme.map((t) => (
                          <li>{t}</li>
                        ))}
                      </ul>
                    </section>
                  )}
                  <section>
                    <h3 class="text-xs font-bold uppercase tracking-wide text-[var(--fg-muted)]">Najnovšie k téme</h3>
                    <ul class="mt-2 space-y-2">
                      {u.zivo.posledne.map((p) => (
                        <li class="text-[15px] leading-snug">
                          <span class="text-xs font-semibold tabular-nums text-[var(--fg-muted)]">
                            {cas(p.cas)} · {p.zdroj}
                          </span>
                          <br />
                          {p.url ? (
                            <a href={p.url} target="_blank" rel="noopener noreferrer" lang={p.jazyk ?? 'sk'} class="font-semibold hover:underline">
                              {p.titulok}
                            </a>
                          ) : (
                            p.titulok
                          )}
                        </li>
                      ))}
                    </ul>
                  </section>
                </div>
              </div>
            </article>
          ))
        }

        <div class="grid gap-6 md:grid-cols-2">
          {
            dalsie.map((u) => (
              <article class="bk-card flex flex-col p-5" id={u.id}>
                <span class:list={['self-start rounded-full border-2 border-[var(--border)] px-2.5 py-0.5 text-xs font-bold uppercase tracking-wide', kickerFarba[u.oblast]]}>
                  {u.kicker}
                </span>
                <h2 class="mt-3 font-display text-[1.45rem] font-extrabold leading-[1.12] tracking-[-0.02em]">{u.titulok}</h2>
                <p class="mt-3 text-[17px] leading-[1.55]">{u.perex}</p>
                <details class="group mt-3">
                  <summary class="cursor-pointer list-none font-display text-sm font-bold underline decoration-[var(--color-pink)] decoration-[3px] underline-offset-4">
                    Čo vieme a čo nevieme
                  </summary>
                  <ul class="mt-3 space-y-2">
                    {u.vieme.map((t) => (
                      <li class="border-l-[3px] border-[var(--color-pink)] pl-3 text-[15px] leading-snug">
                        {t.text} <span class="text-xs font-semibold text-[var(--fg-muted)]">({t.zdroj})</span>
                      </li>
                    ))}
                  </ul>
                  {u.nevieme.length > 0 && (
                    <ul class="mt-3 list-disc space-y-1 rounded-[8px] border-2 border-[var(--border)] bg-[var(--bg)] py-2 pl-7 pr-3 text-[15px] leading-snug">
                      {u.nevieme.map((t) => (
                        <li>{t}</li>
                      ))}
                    </ul>
                  )}
                </details>
                <p class="mt-auto pt-4 text-sm font-semibold text-[var(--fg-muted)]">
                  {cislo.format(u.zivo.zdrojov)} redakcií · {cislo.format(u.zivo.sprav)} správ za 48 h
                  {u.zivo.posledne[0] && ` · posledná ${cas(u.zivo.posledne[0].cas)} ${u.zivo.posledne[0].zdroj}`}
                </p>
              </article>
            ))
          }
        </div>

        <p class="text-sm text-[var(--fg-muted)]">{v.autorstvo}</p>
      </div>

      <aside class="min-w-0 lg:col-span-4">
        <div class="bk-card lg:sticky lg:top-4">
          <div class="border-b-[3px] border-[var(--border)] px-4 py-3">
            <h2 class="font-display text-2xl font-extrabold">Minúta</h2>
            <p class="text-sm text-[var(--fg-muted)]">priebežné správy zo Slovenska a sveta, najnovšie hore</p>
          </div>
          <ol class="stlpec max-h-[calc(100vh-140px)] divide-y-2 divide-[var(--color-line)] overflow-y-auto dark:divide-[#3a3234]">
            {
              v.minuta.map((m) => (
                <li class="px-4 py-3">
                  <div class="text-xs font-semibold tabular-nums text-[var(--fg-muted)]">
                    {cas(m.cas)} · {m.zdroj}
                  </div>
                  {m.url ? (
                    <a href={m.url} target="_blank" rel="noopener noreferrer" class="mt-0.5 block text-[15px] leading-snug hover:underline">
                      {(m.perex ?? m.titulok).slice(0, 260)}
                      {(m.perex ?? m.titulok).length > 260 && '…'}
                    </a>
                  ) : (
                    <p class="mt-0.5 text-[15px] leading-snug">{m.perex ?? m.titulok}</p>
                  )}
                </li>
              ))
            }
          </ol>
        </div>
      </aside>
    </main>

    <script>
      // živé počty: obnova stránky každých 5 minút, keď je karta viditeľná
      setInterval(() => {
        if (document.visibilityState === 'visible' && window.scrollY < 200) location.reload();
      }, 300_000);
    </script>
  </body>
</html>
