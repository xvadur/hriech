---
import '../styles/global.css';
import { OBLASTI, teraz } from '../lib/netopier';

const data = teraz();
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Netopier · Príjem naživo</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23f18fa0'/><circle cx='16' cy='16' r='6' fill='%23181616'/></svg>" />
  </head>
  <body class="min-h-screen">
    <header class="sticky top-0 z-20 border-b-[3px] border-[var(--border)] bg-[var(--bg)]">
      <div class="mx-auto flex max-w-[1680px] flex-wrap items-center gap-x-6 gap-y-3 px-4 py-3 sm:px-6">
        <div class="flex items-baseline gap-3">
          <a href="/" class="font-display text-2xl font-extrabold tracking-tight">NETOPIER</a>
          <a href="/" class="bk-chip bg-[var(--card)] px-3 py-0.5 text-sm font-bold">← Vydanie</a>
          <span class="hidden text-[var(--fg-muted)] sm:inline">príjem naživo, surové správy</span>
        </div>
        <p id="stav" class="flex items-center gap-2 text-sm font-semibold text-[var(--fg-muted)]">
          <span class="live-bodka inline-block size-2.5 rounded-full bg-[var(--color-alarm)]"></span>
          <span id="stav-text">…</span>
        </p>
        <form id="hladaj" class="ml-auto flex w-full gap-2 sm:w-auto" role="search">
          <input
            id="hladaj-q"
            name="q"
            type="search"
            placeholder="Hľadať vo všetkých správach…"
            autocomplete="off"
            class="bk-card w-full px-3 py-1.5 text-base outline-none focus:shadow-[4px_4px_0_0_var(--color-pink)] sm:w-80"
          />
          <button class="bk-card bg-[var(--color-pink)] px-4 py-1.5 font-display font-bold text-[var(--color-ink)]">Hľadaj</button>
        </form>
      </div>
      <nav id="karty" class="mx-auto flex max-w-[1680px] gap-2 px-4 pb-3 lg:hidden" aria-label="Oblasti">
        {
          OBLASTI.map((o, i) => (
            <button class="bk-chip px-3 py-1 font-display font-bold" data-karta={o.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              {o.nazov}
            </button>
          ))
        }
      </nav>
    </header>

    <main class="mx-auto max-w-[1680px] px-4 py-5 sm:px-6">
      <section id="vysledky" class="bk-card mb-5 hidden p-4"></section>
      <div id="oblasti" class="grid gap-5 lg:grid-cols-3">
        {
          OBLASTI.map((o, i) => (
            <section data-oblast={o.id} class:list={['bk-card flex flex-col overflow-hidden', i > 0 && 'max-lg:hidden']}>
              <div class="border-b-[3px] border-[var(--border)] p-4">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h2 class="font-display text-3xl font-extrabold tracking-tight">{o.nazov}</h2>
                    <p class="text-sm text-[var(--fg-muted)]" data-popis>{o.popis}</p>
                  </div>
                  <div class="text-right">
                    <div class="font-display text-3xl font-extrabold tabular-nums" data-za-hodinu>–</div>
                    <div class="text-xs font-semibold text-[var(--fg-muted)]">správ za hodinu</div>
                    <div data-skok class="mt-1 hidden rounded-full border-2 border-[var(--border)] bg-[var(--color-alarm)] px-2 text-xs font-bold text-white"></div>
                  </div>
                </div>
                <div class="mt-3 flex h-9 items-end gap-[2px]" data-hodiny aria-label="Správy po hodinách za 24 hodín"></div>
                <div class="mt-1 flex justify-between text-[11px] text-[var(--fg-muted)]"><span>pred 24 h</span><span>teraz</span></div>
                <div class="mt-3">
                  <div class="mb-1.5 text-xs font-bold uppercase tracking-wide text-[var(--fg-muted)]">Opakuje viac redakcií za 3 h</div>
                  <div class="flex flex-wrap gap-1.5" data-temy></div>
                </div>
              </div>
              <ol class="stlpec divide-y-2 divide-[var(--color-line)] overflow-y-auto lg:h-[calc(100vh-372px)] lg:min-h-[420px] dark:divide-[#3a3234]" data-zoznam></ol>
            </section>
          ))
        }
      </div>
    </main>

    <script is:inline type="application/json" id="data" set:html={JSON.stringify(data)} />
    <script>
      import { spusti } from '../scripts/okno';
      spusti();
    </script>
  </body>
</html>
