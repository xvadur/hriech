{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Netopier v2 — cloudový zber verejných zdrojov.
  // Deploy iba na Adamov pokyn (pozri README.md, časť „Nasadenie“).
  "name": "netopier-zber",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  // Worker nemá verejnú doménu; /health beží na workers.dev (dá sa vypnúť).
  "workers_dev": true,
  "triggers": {
    // */30 — slovenské médiá každých 30 min, svetové kanály World Monitor každé 2 h
    // 20 5 — denný zber štátnych zdrojov (CRZ, TED, ŠÚ SR, kataster, inventár World Monitor)
    "crons": ["*/30 * * * *", "20 5 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "netopier-zber",
      // Doplní sa po `wrangler d1 create netopier-zber` (krok 2 v README).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "RAW", "bucket_name": "netopier-archiv" }
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "netopier-zber-jobs" }],
    "consumers": [
      {
        "queue": "netopier-zber-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "netopier-zber-dlq"
      }
    ]
  },
  "vars": {
    "USER_AGENT": "Netopier/2 (+https://hriech.xvadur.com; zber verejnych zdrojov)"
  },
  "observability": { "enabled": true }
}
