---
import {type Outlet,roleLabel,evidenceLabel,personUrl,rosterLabel} from "../lib/newsrooms";
import {formatDate} from "../lib/content";
import SourceRefs from "./SourceRefs.astro";
import Icon from "./Icon.astro";
interface Props {outlet:Outlet}
const {outlet:o}=Astro.props;
const roleLevels=[...new Set(o.people.flatMap(p=>p.roles.map(r=>r.roleLevel)))];
---
<section data-filter-root>
<h2 class="section-title">Ľudia a verejné roly</h2><p class="section-description">Meno otvorí detail funkcií a ich podklady. Filtre tímu a funkcie sa uplatnia na tú istú rolu.</p>
<form class="search-form" data-filter-form role="search" aria-label="Vyhľadávanie ľudí">
<div class="field"><label for="people-query">Meno alebo rola</label><div class="input-wrap"><Icon name="search" size={20}/><input name="q" id="people-query" type="search" placeholder="Vyhľadať v tomto médiu" autocomplete="off"/></div></div>
<div class="field"><label for="people-unit">Tím</label><select name="tim" id="people-unit"><option value="">Všetky tímy</option>{o.units.map(u=><option value={u.id}>{u.name}</option>)}</select></div>
<div class="field"><label for="people-role">Funkcia</label><select name="funkcia" id="people-role"><option value="">Všetky funkcie</option>{roleLevels.map(r=><option value={r}>{roleLabel(r)}</option>)}</select></div>
<button class="button" type="submit">Vyhľadať</button><button class="chip" type="reset">Zrušiť filtre</button></form>
<p class="result-count" data-result-count role="status" aria-live="polite">Zobrazené: {o.people.length} z {o.people.length}</p>
<div class="records">{o.people.map(p=><details class="record" id={"osoba-"+p.id} data-record data-search={p.name+" "+p.roles.map(r=>r.title).join(" ")} data-roles={JSON.stringify(p.roles.map(r=>({unitId:r.unitId,roleLevel:r.roleLevel})))}>
<summary><span class="record-title">{p.name}<span class="record-subtitle">{p.roles.map(r=>r.title).join(" · ")}</span></span><Icon name="chevron" size={22}/></summary>
<div class="record-body">{p.professionalNote&&<p>{p.professionalNote}</p>}{p.roles.map(r=><div class="role"><strong>{r.title}</strong><p>{o.units.find(u=>u.id===r.unitId)?.name??r.unitId} · {roleLabel(r.roleLevel)}</p><p class="record-meta">{evidenceLabel(r.evidenceState)} · stav roly: {rosterLabel(r.rosterStatus)}</p><SourceRefs outlet={o} ids={r.sourceRefIds}/></div>)}<p class="record-meta">Zachytené {formatDate(p.observedAt)}</p><SourceRefs outlet={o} ids={p.sourceRefIds}/>{p.profileUrl&&<p><a class="text-link" href={p.profileUrl}>Verejný profil <Icon name="external" size={16}/></a></p>}<a class="permalink" href={personUrl(o,p.id)}>Trvalý odkaz na osobu <Icon name="external" size={16}/></a></div>
</details>)}</div>
<div class="empty-state" data-filter-empty hidden><h3>Nenašla sa zodpovedajúca rola.</h3><p>Skús kratšie meno, iný tím alebo zruš filtre.</p></div>
<noscript><p class="data-note">Zobrazené sú všetky osoby. Detaily a zdroje sa otvárajú aj bez JavaScriptu; filtre ho potrebujú.</p></noscript>
</section>
