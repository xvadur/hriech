---
interface SourceRef {
  id: string;
  title: string;
  publisher: string;
  url: string;
  sourceKind: string;
  capturedAt: string;
  note?: string;
}

interface Role {
  title: string;
  unitId: string;
  roleLevel: string;
  rosterStatus: string;
  evidenceState: string;
  sourceRefIds: string[];
}

interface Person {
  id: string;
  name: string;
  profileUrl?: string;
  roles: Role[];
  professionalNote?: string;
  observedAt: string;
  sourceRefIds: string[];
}

interface Unit {
  id: string;
  name: string;
  kind: string;
  parentId?: string;
  description?: string;
  evidenceState: string;
  sourceRefIds: string[];
}

interface Relationship {
  id: string;
  subjectType: string;
  subjectId: string;
  predicate: string;
  objectType: string;
  objectId?: string;
  objectLabel: string;
  note?: string;
  evidenceState: string;
  observedAt: string;
  sourceRefIds: string[];
}

interface FinancialFact {
  id: string;
  period: string;
  metric: string;
  value: number | string;
  unit: string;
  note?: string;
  evidenceState: string;
  sourceRefIds: string[];
}

interface Outlet {
  id: string;
  name: string;
  website: string;
  mappingState: string;
  legalEntity: {
    name: string;
    registrationId: string;
    legalForm: string;
    registeredOffice: string;
    sourceRefIds: string[];
  };
  coverage: {
    summary: string;
    knownGaps: string[];
    rosterObservedAt: string;
  };
  products: Array<{ id: string; name: string; kind: string; relationship: string; url?: string; evidenceState: string; sourceRefIds: string[] }>;
  units: Unit[];
  people: Person[];
  relationships: Relationship[];
  financialFacts: FinancialFact[];
  openQuestions: string[];
}

interface EditorialMapData {
  schemaVersion: string;
  observedAt: string;
  scope: string;
  sourcePolicy: { allowed: string[]; forbidden: string[]; secondarySourcesAreLeadsOnly: boolean };
  privacy: Record<string, boolean>;
  outlets: Outlet[];
  sources: SourceRef[];
}

interface Props { data: EditorialMapData; outletIndex?: number; showGlobal?: boolean }

const { data, outletIndex = 0, showGlobal = outletIndex === 0 } = Astro.props;
const outlet = data.outlets[outletIndex];
const sourcesById = new Map(data.sources.map((source) => [source.id, source]));
const unitsById = new Map(outlet.units.map((unit) => [unit.id, unit]));
const peopleById = new Map(outlet.people.map((person) => [person.id, person]));
const roles = outlet.people.flatMap((person) => person.roles.map((role) => ({ person, role })));
const publisherUnit = outlet.units.find(({ kind, parentId }) => kind === "publisher" && !parentId);
const newsroomUnit = outlet.units.find(({ kind }) => kind === "newsroom");
const visibleUnits = outlet.units.filter(({ id }) => ![publisherUnit?.id, newsroomUnit?.id].includes(id));
const visibleRelationships = outlet.relationships.filter(({ evidenceState }) => evidenceState !== "unknown");
const editorialKinds = new Set(["leadership", "editorial", "desk", "production", "design", "proofreading"]);
const institutionalKinds = new Set(["governance", "ownership", "commercial", "support", "technology", "books"]);
const membersForUnit = (unitId: string) => roles.filter(({ role }) => role.unitId === unitId);
const uniqueMembersForUnit = (unitId: string) => [...new Map(membersForUnit(unitId).map(({ person, role }) => [person.id, { person, role }])).values()];
const editorialUnits = visibleUnits.filter(({ kind }) => editorialKinds.has(kind));
const institutionalUnits = visibleUnits.filter(({ kind }) => institutionalKinds.has(kind));
const chartUnits = [...editorialUnits, ...institutionalUnits]
  .map((unit) => ({ unit, members: uniqueMembersForUnit(unit.id) }))
  .sort((left, right) => right.members.length - left.members.length);
const maxUnitMembers = Math.max(1, ...chartUnits.map(({ members }) => members.length));
const editorialLeaders = [...new Map(roles.filter(({ role }) => role.roleLevel === "editorial_leadership").map(({ person, role }) => [person.id, { person, role }])).values()];
const ownershipPredicates = new Set(["owns", "owns_share_in", "minority_owner_of", "co_owner_of", "owns_via_subsidiary", "shareholder_of", "beneficial_owner_of"]);
const governancePredicates = new Set(["executive_of", "chair_of_board", "board_member_of", "supervisory_board_member_of", "editorial_council_member_of"]);
const allOwnershipRelationships = visibleRelationships.filter(({ predicate }) => ownershipPredicates.has(predicate));
const governanceRelationships = visibleRelationships.filter(({ predicate }) => governancePredicates.has(predicate));
const publicRelationships = visibleRelationships.filter(({ predicate }) => ["received_public_funds_from", "contracted_with", "partner_public_sector"].includes(predicate));
const outletSourceIds = new Set([
  ...outlet.legalEntity.sourceRefIds,
  ...outlet.products.flatMap(({ sourceRefIds }) => sourceRefIds),
  ...outlet.units.flatMap(({ sourceRefIds }) => sourceRefIds),
  ...outlet.people.flatMap(({ sourceRefIds, roles }) => [...sourceRefIds, ...roles.flatMap(({ sourceRefIds: roleSources }) => roleSources)]),
  ...outlet.relationships.flatMap(({ sourceRefIds }) => sourceRefIds),
  ...outlet.financialFacts.flatMap(({ sourceRefIds }) => sourceRefIds),
]);
const outletSources = data.sources.filter(({ id }) => outletSourceIds.has(id));
const normalizePersonName = (name: string) => name.normalize("NFKC").trim().toLocaleLowerCase("sk-SK");
const uniquePeople = new Set(data.outlets.flatMap((item) => item.people.map(({ name }) => normalizePersonName(name)))).size;
const directEditorialRoleLevels = new Set(["editorial_staff", "external_contributor", "unit_lead"]);
const directEditorialRecords = data.outlets.reduce((total, item) => total + item.people.filter(({ roles }) => roles.some(({ roleLevel }) => directEditorialRoleLevels.has(roleLevel))).length, 0);
const totalRoles = data.outlets.reduce((total, item) => total + item.people.flatMap(({ roles }) => roles).length, 0);
const totalUnits = data.outlets.reduce((total, item) => total + item.units.length, 0);
const formatDate = (value: string) => new Intl.DateTimeFormat("sk-SK", { day: "numeric", month: "long", year: "numeric" }).format(new Date(value));
const formatValue = (value: number | string, unit: string) => typeof value === "number"
  ? `${new Intl.NumberFormat("sk-SK").format(value)} ${unit}`
  : `${value} · ${unit}`;
const evidenceLabel = (state: string) => ({
  current_verified: "aktuálne overené",
  documented_historical: "historicky doložené",
  inference: "inferencia",
  unknown: "neznáme",
}[state] ?? state);
const entityLabels = new Map(outlet.relationships.flatMap((relationship) => relationship.objectId ? [[relationship.objectId, relationship.objectLabel] as const] : []));
for (const relationship of outlet.relationships) {
  if (relationship.subjectType === "legal_entity" && relationship.objectType === "outlet") entityLabels.set(relationship.subjectId, outlet.legalEntity.name);
}
const subjectLabel = (relationship: Relationship) => relationship.subjectType === "person"
  ? peopleById.get(relationship.subjectId)?.name ?? relationship.subjectId
  : unitsById.get(relationship.subjectId)?.name
    ?? entityLabels.get(relationship.subjectId)
    ?? (relationship.subjectId === outlet.id ? outlet.name : "Verejne evidovaný subjekt");
const normalizeEntityLabel = (value: string) => value.toLocaleLowerCase("sk").replaceAll(/[^a-záäčďéíĺľňóôŕšťúýž0-9]/g, "");
const ownershipTargetLabels = new Set([outlet.legalEntity.name, publisherUnit?.name].filter(Boolean).map((label) => normalizeEntityLabel(label as string)));
const ownershipRelationships: Relationship[] = [];
for (let depth = 0; depth < 4; depth += 1) {
  for (const relationship of allOwnershipRelationships) {
    const objectLabel = normalizeEntityLabel(relationship.objectLabel);
    const pointsToMappedOwner = [...ownershipTargetLabels].some((target) => objectLabel === target || objectLabel.startsWith(target));
    if (ownershipRelationships.includes(relationship) || !pointsToMappedOwner) continue;
    ownershipRelationships.push(relationship);
    ownershipTargetLabels.add(normalizeEntityLabel(subjectLabel(relationship)));
  }
}
const governancePreview = governanceRelationships.slice(0, 3);
const governanceRemainder = Math.max(0, governanceRelationships.length - governancePreview.length);
const predicateLabel = (predicate: string) => ({
  leads: "vedie",
  member_of: "je členom",
  works_for: "pracuje pre",
  executive_of: "je konateľom",
  chair_of_board: "predsedá predstavenstvu",
  board_member_of: "je členom predstavenstva",
  supervisory_board_member_of: "je členom dozornej rady",
  editorial_council_member_of: "je členom redakčnej rady",
  beneficial_owner_of: "je konečný užívateľ výhod",
  shareholder_of: "je akcionárom",
  owns: "vlastní",
  owns_share_in: "má podiel v",
  minority_owner_of: "má menšinový podiel v",
  co_owner_of: "je spoluvlastníkom",
  owns_via_subsidiary: "vlastní cez dcérsku spoločnosť",
  partner_public_sector: "je zapísaný v",
  cooperates_with: "spolupracuje s",
  received_public_funds_from: "má verejnú finančnú väzbu na",
  contracted_with: "uzavrel zmluvu s",
  publishes: "vydáva",
  operates: "prevádzkuje",
}[predicate] ?? predicate);
const unitKindLabel = (kind: string) => ({
  leadership: "vedenie",
  editorial: "redakčný tím",
  desk: "tematický desk",
  production: "produkcia",
  design: "vizuál a dizajn",
  proofreading: "jazyková úprava",
  governance: "dohľad",
  ownership: "vlastníctvo",
  commercial: "obchod",
  support: "podpora",
  technology: "technológie",
  books: "knižná produkcia",
}[kind] ?? kind);
const unitTone = (kind: string) => ["editorial", "desk"].includes(kind)
  ? "content"
  : ["production", "design", "proofreading", "technology"].includes(kind)
    ? "production"
    : "support";
---

<article class="editorial-map" id={`outlet-${outlet.id}`} data-editorial-map data-outlet-index={outletIndex}>
  {showGlobal && <header class="editorial-map__hero">
    <div>
      <span class="editorial-map__eyebrow">Hriech / 01 — Redakcie</span>
      <h1>Kto tvorí slovenský informačný priestor?</h1>
      <p>Desať veľkých online médií pôsobí ako desať samostatných svetov. Verejné rostre a registre ukazujú oveľa menšie personálne jadro: {uniquePeople} identifikovateľných ľudí.</p>
    </div>
    <div class="editorial-map__stamp">
      <span>verejný register</span>
      <strong>{formatDate(data.observedAt)}</strong>
      <small>živá mapa · údaje sa môžu meniť</small>
    </div>
  </header>}

  {showGlobal && <section class="editorial-map__metrics" aria-label="Rozsah mapovania">
    <div><strong>5,4 mil.</strong><span>obyvateľov Slovenska</span><a href="https://slovak.statistics.sk/wps/portal/ext/products/informationmessages/inf_sprava_detail/973bd7ac-eb08-42ef-b5d9-b227e47c01f1/" target="_blank" rel="noreferrer">ŠÚ SR · koniec 2025 ↗</a></div>
    <div><strong>{data.outlets.length}</strong><span>vybraných online médií</span></div>
    <div><strong>{uniquePeople}</strong><span>unikátnych verejných mien</span></div>
    <div><strong>{directEditorialRecords}</strong><span>ľudí v priamej redakčnej a autorskej vrstve</span></div>
    <div><strong>{data.sources.length}</strong><span>verejných zdrojov</span></div>
  </section>}

  {showGlobal && <section class="editorial-map__thesis" aria-label="Čo mapa dokazuje">
    <div><span>Čo vieme</span><p>V desiatich vybraných médiách sme z verejných zdrojov identifikovali {uniquePeople} unikátnych ľudí a {totalRoles} profesijných rolí v {totalUnits} organizačných jednotkách.</p></div>
    <div><span>Čo ešte netvrdíme</span><p>Mapa nedokazuje, že táto skupina riadi celý informačný priestor. Nezahŕňa televízie, STVR, rádiá, TASR, regióny, tlačové oddelenia ani platformové algoritmy.</p></div>
    <div><span>Ďalšia otázka</span><p>Koľko ľudí reálne rozhoduje o výbere tém, titulkoch a redakčných prioritách? Verejné formálne roly ukazujú smer, nie úplný vnútorný rozhodovací proces.</p></div>
  </section>}

  {showGlobal && <section class="editorial-map__boundary" aria-label="Hranica výskumu">
    <div>
      <span>Verejný záujem</span>
      <p>Profesijné roly, vlastníctvo právnických osôb, financie, verejné peniaze, zmluvy a inštitucionálne väzby.</p>
    </div>
    <div>
      <span>Hranica</span>
      <p>Bez súkromných adries, rodných údajov, rodiny, osobných kontaktov a majetkového lustrovania fyzických osôb.</p>
    </div>
  </section>}

  {showGlobal && <nav class="editorial-map__outlet-switch" aria-label="Zmapované redakcie">
    {data.outlets.map((item, index) => <a href={`#${item.id}-organigram`} data-outlet-select={item.id}><span>{String(index + 1).padStart(2, "0")}</span>{item.name}</a>)}
  </nav>}

  <div class="editorial-map__outlet-view" data-outlet-view={outlet.id}>
  <nav class="editorial-map__subnav" aria-label="Sekcie mapy">
    <label class="editorial-map__outlet-picker"><span>Médium</span><select data-outlet-picker aria-label="Vybrať médium">{data.outlets.map((item) => <option value={item.id} selected={item.id === outlet.id}>{item.name}</option>)}</select></label>
    <a href={`#${outlet.id}-organigram`} data-map-tab="organigram">Prehľad</a>
    <a href={`#${outlet.id}-ludia`} data-map-tab="ludia">Ľudia</a>
    <a href={`#${outlet.id}-vazby`} data-map-tab="vazby">Väzby</a>
    <a href={`#${outlet.id}-financie`} data-map-tab="financie">Financie</a>
    <a href={`#${outlet.id}-zdroje`} data-map-tab="zdroje">Zdroje</a>
  </nav>

  <section class="editorial-map__outlet">
    <div>
      <span>{String(outletIndex + 1).padStart(2, "0")} / médium</span>
      <h2>{outlet.name}</h2>
      <p>{outlet.coverage.summary}</p>
    </div>
    <dl>
      <div><dt>Vydavateľ</dt><dd>{outlet.legalEntity.name}</dd></div>
      <div><dt>IČO</dt><dd>{outlet.legalEntity.registrationId}</dd></div>
      <div><dt>Právna forma</dt><dd>{outlet.legalEntity.legalForm}</dd></div>
      <div><dt>Sídlo právnickej osoby</dt><dd>{outlet.legalEntity.registeredOffice}</dd></div>
    </dl>
  </section>

  <section class="editorial-map__section" id={`${outlet.id}-organigram`} data-map-panel="organigram">
    <div class="editorial-map__section-head">
      <div><span>02 / mapa moci a práce</span><h2>Mapa vlastníctva a redakcie</h2></div>
      <p>Čítaj zľava doprava: vlastníci ovládajú vydavateľa, vydavateľ prevádzkuje médium, verejne uvedené vedenie zodpovedá za obsah a tímy ho vyrábajú.</p>
    </div>

    <div class="editorial-map__map-key" aria-label="Legenda organizačnej mapy">
      <strong>Ako čítať mapu</strong>
      <span data-kind="owner"><i></i>Vlastníctvo</span>
      <span data-kind="publisher"><i></i>Právna a obchodná kontrola</span>
      <span data-kind="editorial"><i></i>Rozhodovanie o obsahu</span>
      <span data-kind="team"><i></i>Redakčná výroba</span>
      <span data-kind="governance"><i></i>Zákonné orgány a dohľad</span>
    </div>

    <section class="editorial-map__power-map" aria-label={`Mapa vlastníctva a redakčnej štruktúry ${outlet.name}`}>
      <header class="editorial-map__power-head">
        <div><span>Tok formálnej kontroly</span><h3>{outlet.name}</h3></div>
        <p><b>{outlet.people.length}</b> verejne pomenovaných ľudí · <b>{editorialUnits.length}</b> redakčných jednotiek</p>
      </header>

      <div class="editorial-map__control-chain">
      <div class="editorial-map__power-stage editorial-map__power-stage--owners">
        <div class="editorial-map__stage-label"><b>01</b><span>Kapitál</span><small>Kto médium vlastní</small></div>
        <div class="editorial-map__owner-grid">
          {ownershipRelationships.length ? ownershipRelationships.map((relationship) => (
            <article class="editorial-map__power-node" data-kind="owner">
              <small>vlastník / akcionár</small>
              <h4>{subjectLabel(relationship)}</h4>
              <p>{predicateLabel(relationship.predicate)} <strong>{relationship.objectLabel}</strong></p>
            </article>
          )) : (
            <article class="editorial-map__power-node editorial-map__power-node--gap" data-kind="owner">
              <small>verejná dátová medzera</small><h4>Vlastnícka vrstva nie je rozpísaná</h4>
            </article>
          )}
        </div>
      </div>

      <div class="editorial-map__flow-arrow" data-kind="owner" aria-hidden="true"><i></i><span>kapitálová kontrola</span></div>

      <div class="editorial-map__power-stage editorial-map__power-stage--publisher">
        <div class="editorial-map__stage-label"><b>02</b><span>Vydavateľ</span><small>Kto médium právne prevádzkuje</small></div>
        <article class="editorial-map__power-node editorial-map__power-node--publisher" data-kind="publisher">
          <small>právnická osoba</small>
          <h4>{outlet.legalEntity.name}</h4>
          <p>IČO {outlet.legalEntity.registrationId} · {outlet.legalEntity.legalForm}</p>
        </article>
        <aside class="editorial-map__governance" data-kind="governance">
          <header><span>Zákonné riadenie a dohľad</span><b>{governanceRelationships.length}</b></header>
          {governancePreview.length ? governancePreview.map((relationship) => (
            <p><strong>{subjectLabel(relationship)}</strong><span>{predicateLabel(relationship.predicate)} · {relationship.objectLabel}</span></p>
          )) : <p><strong>Verejne nerozpísané</strong><span>V tejto vrstve zatiaľ nemáme doložené osoby.</span></p>}
          {governanceRemainder > 0 && <footer>+ {governanceRemainder} ďalších doložených rolí v registri vzťahov</footer>}
        </aside>
      </div>

      <div class="editorial-map__flow-arrow" data-kind="publisher" aria-hidden="true"><i></i><span>prevádzkuje médium</span></div>

      <div class="editorial-map__power-stage editorial-map__power-stage--editorial">
        <div class="editorial-map__stage-label"><b>03</b><span>Obsah</span><small>Kto verejne nesie redakčnú zodpovednosť</small></div>
        <div class="editorial-map__editorial-core">
          <article class="editorial-map__power-node editorial-map__power-node--newsroom" data-kind="editorial">
            <small>redakcia</small>
            <h4>{newsroomUnit?.name ?? `Redakcia ${outlet.name}`}</h4>
            <p>{outlet.mappingState === "partial" ? "Zverejnený zoznam ľudí nie je úplný" : "Aktuálny verejný zoznam je zmapovaný"}</p>
          </article>
          <div class="editorial-map__leader-grid">
            {editorialLeaders.length ? editorialLeaders.map(({ person, role }) => (
              <article class="editorial-map__leader-card"><small>{role.title}</small><h4>{person.name}</h4></article>
            )) : <article class="editorial-map__leader-card"><small>verejná dátová medzera</small><h4>Vedenie nie je rozpísané</h4></article>}
          </div>
        </div>
      </div>
      </div>

      <div class="editorial-map__flow-arrow" data-kind="editorial" aria-hidden="true"><i></i><span>zadáva a koordinuje redakčnú prácu</span></div>

      <div class="editorial-map__power-stage editorial-map__power-stage--teams">
        <div class="editorial-map__stage-label"><b>04</b><span>Tímy</span><small>Kde vzniká obsah</small></div>
        <div class="editorial-map__team-grid">
          {editorialUnits.filter(({ kind }) => kind !== "leadership").map((unit) => {
            const members = uniqueMembersForUnit(unit.id);
            const leads = members.filter(({ role }) => role.roleLevel === "unit_lead");
            return <article class="editorial-map__team-card" data-tone={unitTone(unit.kind)}>
              <div><small>{unitKindLabel(unit.kind)}</small><strong>{members.length || "?"}</strong></div>
              <h4>{unit.name}</h4>
              <p>{leads.length ? <>Vedie: <b>{leads.map(({ person }) => person.name).join(", ")}</b></> : (members.length ? "Verejne priradení členovia" : "Členstvo nezverejnené")}</p>
            </article>;
          })}
        </div>
      </div>
    </section>

    <details class="editorial-map__deep-dive">
      <summary><span>Auditný detail, rozloženie tímov a všetky roly</span><b>Otvoriť</b></summary>
    {publicRelationships.length > 0 && <section class="editorial-map__public-links" aria-label={`Verejné inštitucionálne väzby ${outlet.name}`}>
      <header><span>Verejné inštitucionálne väzby</span><b>Neznamenajú automaticky vplyv ani konflikt</b></header>
      <div>{publicRelationships.map((relationship) => <p><strong>{subjectLabel(relationship)}</strong><span>{predicateLabel(relationship.predicate)}</span><b>{relationship.objectLabel}</b></p>)}</div>
    </section>}

    <section class="editorial-map__diagram editorial-map__diagram--distribution" aria-label={`Rozloženie tímu ${outlet.name}`}>
      <header><span>Kam sú ľudia verejne priradení</span><b>Veľkosť tímov podľa publikovaných rolí</b></header>
      <div class="editorial-map__distribution">
        {chartUnits.map(({ unit, members }) => <div data-tone={unitTone(unit.kind)}><span>{unit.name}</span><i><b style={`--unit-share:${Math.max(3, (members.length / maxUnitMembers) * 100)}%`}></b></i><strong>{members.length || "?"}</strong></div>)}
      </div>
    </section>

    <div class="editorial-map__detail-label">
      <span>Rozpis jednotiek a verejne uvedených členov</span>
      <p>Diagram hore ukazuje hierarchiu; rozbaľovacie bloky nižšie držia auditovateľný detail.</p>
    </div>

    <div class="editorial-map__unit-grid">
      {visibleUnits.map((unit) => {
        const members = roles.filter(({ role }) => role.unitId === unit.id);
        return (
          <details class="editorial-map__unit" open={members.length > 0 && members.length < 10}>
            <summary>
              <span>{unitKindLabel(unit.kind)}</span>
              <h3>{unit.name}</h3>
              <b>{members.length} rolí</b>
            </summary>
            {unit.description && <p>{unit.description}</p>}
            {members.length ? (
              <ul>{members.map(({ person, role }) => <li><strong>{person.name}</strong><span>{role.title}</span></li>)}</ul>
            ) : (
              <p class="editorial-map__gap">Členstvo nie je vo verejnom rostri rozpísané.</p>
            )}
          </details>
        );
      })}
    </div>
    </details>
  </section>

  <section class="editorial-map__section" id={`${outlet.id}-ludia`} data-map-panel="ludia" hidden>
    <div class="editorial-map__section-head">
      <div><span>03 / register</span><h2>Ľudia a verejné roly</h2></div>
      <p>Oficiálny tím je doplnený o zákonné orgány, vlastnícku vrstvu a redakčnú radu. Duplicitné mená s viacerými rolami sú zlúčené do jedného profilu.</p>
    </div>
    <div class="editorial-map__filters">
      <label><span>Hľadať</span><input type="search" placeholder="Meno alebo rola" data-people-search /></label>
      <label><span>Jednotka</span><select data-people-unit><option value="">Všetky jednotky</option>{visibleUnits.map((unit) => <option value={unit.id}>{unit.name}</option>)}</select></label>
      <label><span>Úroveň</span><select data-people-level><option value="">Všetky úrovne</option><option value="editorial_leadership">Vedenie redakcie</option><option value="unit_lead">Vedúci tímov</option><option value="editorial_staff">Redakcia</option><option value="production_staff">Produkcia</option><option value="support_staff">Podpora</option><option value="publisher_leadership">Vedenie vydavateľstva</option><option value="governance">Orgány a redakčná rada</option><option value="owner">Vlastnícka vrstva</option><option value="commercial_staff">Obchod</option><option value="technology_staff">Technológie</option><option value="external_contributor">Externí spolupracovníci</option></select></label>
      <output data-people-count>{outlet.people.length} osôb</output>
    </div>
    <div class="editorial-map__people">
      {outlet.people.map((person) => {
        const units = [...new Set(person.roles.map(({ unitId }) => unitId))];
        const levels = [...new Set(person.roles.map(({ roleLevel }) => roleLevel))];
        const search = `${person.name} ${person.roles.map(({ title }) => title).join(" ")}`.toLocaleLowerCase("sk");
        return (
          <article data-person data-search={search} data-units={units.join(" ")} data-levels={levels.join(" ")}>
            <span>{person.roles.map(({ unitId }) => unitsById.get(unitId)?.name).filter(Boolean).join(" · ")}</span>
            <h3>{person.name}</h3>
            <ul>{person.roles.map((role) => <li>{role.title}{role.evidenceState === "documented_historical" && <em> · historicky doložené</em>}</li>)}</ul>
            {person.professionalNote && <p>{person.professionalNote}</p>}
            <small>pozorované {formatDate(person.observedAt)}</small>
          </article>
        );
      })}
    </div>
    <p class="editorial-map__empty" data-people-empty hidden>Tomuto filtru nezodpovedá žiadna verejne uvedená rola.</p>
  </section>

  <section class="editorial-map__section" id={`${outlet.id}-vazby`} data-map-panel="vazby" hidden>
    <div class="editorial-map__section-head">
      <div><span>04 / vzťahy</span><h2>Profesionálne a inštitucionálne väzby</h2></div>
      <p>Zobrazená väzba neznamená konflikt ani vplyv. Je to overený fakt, ku ktorému sa význam pridáva až po pomenovaní mechanizmu.</p>
    </div>
    <div class="editorial-map__relationships">
      {visibleRelationships.map((relationship) => (
        <article>
          <span>{evidenceLabel(relationship.evidenceState)}</span>
          <h3><b>{subjectLabel(relationship)}</b> {predicateLabel(relationship.predicate)} <b>{relationship.objectLabel}</b></h3>
          {relationship.note && <p>{relationship.note}</p>}
          <footer>{relationship.sourceRefIds.map((id) => { const source = sourcesById.get(id); return source && <a href={source.url} target="_blank" rel="noreferrer">{source.publisher} ↗</a>; })}</footer>
        </article>
      ))}
    </div>
  </section>

  <section class="editorial-map__section" id={`${outlet.id}-financie`} data-map-panel="financie" hidden>
    <div class="editorial-map__section-head">
      <div><span>05 / čísla</span><h2>Finančné a verejné stopy</h2></div>
      <p>Účtovné riadky, roster a verejné zmluvy majú rozdielne menovatele. Tab ich drží oddelene, aby z nich nevzniklo falošné jedno číslo.</p>
    </div>
    <div class="editorial-map__finance">
      {outlet.financialFacts.map((fact) => (
        <article>
          <span>{fact.period}</span>
          <h3>{fact.metric}</h3>
          <strong>{formatValue(fact.value, fact.unit)}</strong>
          {fact.note && <p>{fact.note}</p>}
          <footer>{fact.sourceRefIds.map((id) => { const source = sourcesById.get(id); return source && <a href={source.url} target="_blank" rel="noreferrer">zdroj ↗</a>; })}</footer>
        </article>
      ))}
    </div>
  </section>

  <section class="editorial-map__section" id={`${outlet.id}-zdroje`} data-map-panel="zdroje" hidden>
    <div class="editorial-map__section-head">
      <div><span>06 / audit</span><h2>Zdroje, medzery a ďalšie otázky</h2></div>
      <p>Sekcia je pracovný register. Sekundárny agregátor môže ukázať stopu, no tvrdenie sa povýši až po návrate k pôvodnému registru alebo dokumentu.</p>
    </div>
    <div class="editorial-map__sources">
      {outletSources.map((source, index) => (
        <a href={source.url} target="_blank" rel="noreferrer">
          <span>{String(index + 1).padStart(2, "0")} · {source.sourceKind.replaceAll("_", " ")}</span>
          <h3>{source.title}</h3>
          <p>{source.publisher}</p>
          <small>zachytené {formatDate(source.capturedAt)} ↗</small>
        </a>
      ))}
    </div>
    <div class="editorial-map__questions">
      <article><span>Známe medzery</span><ol>{outlet.coverage.knownGaps.map((gap) => <li>{gap}</li>)}</ol></article>
      <article><span>Otvorené investigatívne otázky</span><ol>{outlet.openQuestions.map((question) => <li>{question}</li>)}</ol></article>
    </div>
  </section>
  </div>
</article>

<script>
  const editorialMaps = [...document.querySelectorAll<HTMLElement>("[data-editorial-map]")];

  editorialMaps.forEach((root) => {
    const search = root.querySelector<HTMLInputElement>("[data-people-search]");
    const unit = root.querySelector<HTMLSelectElement>("[data-people-unit]");
    const level = root.querySelector<HTMLSelectElement>("[data-people-level]");
    const people = [...root.querySelectorAll<HTMLElement>("[data-person]")];
    const count = root.querySelector<HTMLOutputElement>("[data-people-count]");
    const empty = root.querySelector<HTMLElement>("[data-people-empty]");
    const filterPeople = () => {
      const query = search?.value.trim().toLocaleLowerCase("sk") ?? "";
      let visible = 0;
      for (const person of people) {
        const matchesQuery = !query || (person.dataset.search ?? "").includes(query);
        const matchesUnit = !unit?.value || (person.dataset.units ?? "").split(" ").includes(unit.value);
        const matchesLevel = !level?.value || (person.dataset.levels ?? "").split(" ").includes(level.value);
        const show = matchesQuery && matchesUnit && matchesLevel;
        person.hidden = !show;
        if (show) visible += 1;
      }
      if (count) count.value = `${visible} osôb`;
      if (empty) empty.hidden = visible !== 0;
    };
    search?.addEventListener("input", filterPeople);
    unit?.addEventListener("change", filterPeople);
    level?.addEventListener("change", filterPeople);
    root.querySelector<HTMLSelectElement>("[data-outlet-picker]")?.addEventListener("change", (event) => {
      const selectedOutlet = (event.currentTarget as HTMLSelectElement).value;
      location.hash = `${selectedOutlet}-organigram`;
    });
  });

  const activateEditorialView = (outletId: string, panelId = "organigram", jump = false) => {
    editorialMaps.forEach((root, index) => {
      const view = root.querySelector<HTMLElement>("[data-outlet-view]");
      const isActiveOutlet = view?.dataset.outletView === outletId;
      if (index > 0) root.style.display = isActiveOutlet ? "block" : "none";
      if (view) view.hidden = !isActiveOutlet;
      const picker = root.querySelector<HTMLSelectElement>("[data-outlet-picker]");
      if (picker) picker.value = outletId;
      root.querySelectorAll<HTMLElement>("[data-map-panel]").forEach((panel) => {
        panel.hidden = !isActiveOutlet || panel.dataset.mapPanel !== panelId;
      });
      root.querySelectorAll<HTMLAnchorElement>("[data-map-tab]").forEach((tab) => {
        const isActiveTab = isActiveOutlet && tab.dataset.mapTab === panelId;
        tab.toggleAttribute("aria-current", isActiveTab);
      });
    });
    document.querySelectorAll<HTMLAnchorElement>("[data-outlet-select]").forEach((link) => {
      link.toggleAttribute("aria-current", link.dataset.outletSelect === outletId);
    });
    if (jump) requestAnimationFrame(() => {
      const target = document.getElementById(`${outletId}-${panelId}`);
      if (!target) return;
      const previous = document.documentElement.style.scrollBehavior;
      document.documentElement.style.scrollBehavior = "auto";
      target.scrollIntoView({ block: "start" });
      document.documentElement.style.scrollBehavior = previous;
    });
  };

  const viewFromHash = (jump = false) => {
    const hash = decodeURIComponent(location.hash.slice(1));
    const matched = editorialMaps.map((root) => root.querySelector<HTMLElement>("[data-outlet-view]")?.dataset.outletView).filter(Boolean).find((id) => hash === `outlet-${id}` || hash.startsWith(`${id}-`));
    const outletId = matched ?? editorialMaps[0]?.querySelector<HTMLElement>("[data-outlet-view]")?.dataset.outletView;
    if (!outletId) return;
    const requestedPanel = hash.startsWith(`${outletId}-`) ? hash.slice(outletId.length + 1) : "organigram";
    const panelId = ["organigram", "ludia", "vazby", "financie", "zdroje"].includes(requestedPanel) ? requestedPanel : "organigram";
    activateEditorialView(outletId, panelId, jump);
  };

  window.addEventListener("hashchange", () => viewFromHash(true));
  viewFromHash(false);
</script>

