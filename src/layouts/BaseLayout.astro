---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
interface Props { title: string; description: string; type?: string; image?: string; noindex?: boolean }
const { title, description, type = "website", image = "/brand/hriech-original.png", noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const active = Astro.url.pathname;
---
<!doctype html>
<html lang="sk">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{title}</title><meta name="description" content={description}/>
  <meta name="theme-color" content="#F18FA0"/>
  {noindex && <meta name="robots" content="noindex,nofollow"/>}
  <meta property="og:type" content={type}/><meta property="og:locale" content="sk_SK"/>
  <meta property="og:site_name" content="Hriech"/><meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
  <meta property="og:image" content={new URL(image, Astro.site)}/>
  <meta name="twitter:card" content="summary_large_image"/>
  <link rel="canonical" href={canonical}/><link rel="icon" type="image/png" href="/brand/hriech-icon.png"/>
  <link rel="alternate" type="application/rss+xml" title="Hriech — publikácie" href="/rss.xml"/>
</head>
<body>
  <a class="skip-link" href="#obsah">Preskočiť na obsah</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/" aria-label="Hriech — titulka"><img src="/brand/hriech-wordmark.png" alt="hriech" width="448" height="200" fetchpriority="high"/></a>
      <nav class="main-nav" aria-label="Hlavná navigácia">
        <a href="/" aria-current={active === "/" || active.startsWith("/publikacie") || active.startsWith("/pripady") ? "page" : undefined}>Publikácie</a>
        <a href="/mapy" aria-current={active.startsWith("/mapy") ? "page" : undefined}>Mapy</a>
        <a href="/o-hriechu" aria-current={active === "/o-hriechu" ? "page" : undefined}>O Hriechu</a>
      </nav>
      <a class="parent-brand" href="https://xvadur.com">XVADUR <Icon name="external" size={17}/></a>
    </div>
  </header>
  <main id="obsah" tabindex="-1"><slot/></main>
  <footer class="site-footer"><div><a href="/" class="footer-name">hriech</a><p>Publikácie, postrehy a mapy súvislostí.<br/>Pod značkou <a href="https://xvadur.com">XVADUR</a>.</p></div><nav aria-label="Päta"><a href="/o-hriechu">O Hriechu</a><a href="/pripady/redakcie">Prípad Redakcie</a><a href="/rss.xml">RSS</a></nav></footer>
</body>
</html>
